<?xml version="1.0" encoding="UTF-8"?>
<module moduleId="rf433-tx-fs1000a-hwlab" fritzingVersion="1.0.4">
 <version>1</version>
 <date>2026-09-06</date>
 <author>hw-laboratorio</author>
 <title>RF 433 MHz TX (FS1000A)</title>
 <label>M</label>
 <description>Modulo transmissor de radiofrequencia 433 MHz por modulacao de amplitude (ASK/OOK), modelo MX-FS-03V, tambem serigrafado FS1000A. Placa de 19 x 19 mm, alimentacao de 3,5 a 12 V — quanto maior a tensao, maior o alcance. Um unico pino de dados. Sem antena o alcance e de centimetros: um fio reto de 17,3 cm e um quarto de onda em 433,92 MHz e resolve. Pinagem DATA VCC GND, da esquerda para a direita vista de cima. Bibliotecas RadioHead RH_ASK ou RCSwitch.</description>
 <url>https://github.com/henriquemattosesilva/hw-laboratorio</url>
 <tags>
  <tag>rf</tag>
  <tag>433mhz</tag>
  <tag>transmitter</tag>
  <tag>ask</tag>
  <tag>fs1000a</tag>
  <tag>mx-fs-03v</tag>
 </tags>
 <properties>
  <property name="family">rf module 433mhz</property>
  <property name="variant">transmitter FS1000A</property>
  <property name="part number">MX-FS-03V</property>
  <property name="frequency">433 MHz</property>
  <property name="voltage">3.5-12V</property>
  <property name="modulation">ASK/OOK</property>
 </properties>
 <views>
  <breadboardView>
   <layers image="breadboard/rf433_tx_breadboard.svg">
    <layer layerId="breadboard"/>
   </layers>
  </breadboardView>
  <schematicView>
   <layers image="schematic/rf433_tx_schematic.svg">
    <layer layerId="schematic"/>
   </layers>
  </schematicView>
  <pcbView>
   <layers image="pcb/rf433_tx_pcb.svg">
    <layer layerId="copper1"/>
    <layer layerId="copper0"/>
    <layer layerId="silkscreen"/>
   </layers>
  </pcbView>
  <iconView>
   <layers image="icon/rf433_tx_icon.svg">
    <layer layerId="icon"/>
   </layers>
  </iconView>
 </views>
 <connectors>
  <connector type="male" name="DATA" id="connector0">
   <description>Entrada de dados serial, nivel logico do microcontrolador</description>
   <views>
    <breadboardView><p svgId="connector0pin" layer="breadboard"/></breadboardView>
    <schematicView><p svgId="connector0pin" layer="schematic"/></schematicView>
    <pcbView><p svgId="connector0pin" layer="copper0"/><p svgId="connector0pin" layer="copper1"/></pcbView>
   </views>
  </connector>
  <connector type="male" name="VCC" id="connector1">
   <description>Alimentacao, 3,5 a 12 V</description>
   <views>
    <breadboardView><p svgId="connector1pin" layer="breadboard"/></breadboardView>
    <schematicView><p svgId="connector1pin" layer="schematic"/></schematicView>
    <pcbView><p svgId="connector1pin" layer="copper0"/><p svgId="connector1pin" layer="copper1"/></pcbView>
   </views>
  </connector>
  <connector type="male" name="GND" id="connector2">
   <description>Terra</description>
   <views>
    <breadboardView><p svgId="connector2pin" layer="breadboard"/></breadboardView>
    <schematicView><p svgId="connector2pin" layer="schematic"/></schematicView>
    <pcbView><p svgId="connector2pin" layer="copper0"/><p svgId="connector2pin" layer="copper1"/></pcbView>
   </views>
  </connector>
  <connector type="male" name="ANT" id="connector3">
   <description>Furo da antena; um fio reto de 17,3 cm e um quarto de onda em 433,92 MHz</description>
   <views>
    <breadboardView><p svgId="connector3pin" layer="breadboard"/></breadboardView>
    <schematicView><p svgId="connector3pin" layer="schematic"/></schematicView>
    <pcbView><p svgId="connector3pin" layer="copper0"/><p svgId="connector3pin" layer="copper1"/></pcbView>
   </views>
  </connector>
 </connectors>
 <buses/>
</module>
