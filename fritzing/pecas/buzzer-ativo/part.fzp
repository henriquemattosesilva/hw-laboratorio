<?xml version="1.0" encoding="UTF-8"?>
<module moduleId="buzzer-ativo-hwlab" fritzingVersion="1.0.4">
 <version>1</version>
 <date>2026-09-06</date>
 <author>hw-laboratorio</author>
 <title>Modulo Buzzer Ativo P15 (GBK)</title>
 <label>M</label>
 <description>Modulo buzzer ativo GBK P15, placa de 32 x 15 x 11 mm. Ativo quer dizer que o oscilador esta dentro: toca uma nota so, e o codigo apenas liga e desliga. Para tocar melodia seria preciso um passivo. Alimentacao de 3,3 a 5 V, ate 42 mA, saida acima de 85 dB. Dois pinos numa das pontas, GND em cima e SINAL embaixo com a serigrafia legivel. A POLARIDADE DE ACIONAMENTO NAO FOI VERIFICADA: varios modulos P15 tocam com nivel BAIXO, e se apitar parado e calar ao acionar, e isso.</description>
 <url>https://github.com/henriquemattosesilva/hw-laboratorio</url>
 <tags>
  <tag>buzzer-ativo</tag>
  <tag>gnd</tag>
  <tag>p15</tag>
  <tag>gbk</tag>
  <tag>sinal</tag>
 </tags>
 <properties>
  <property name="family">buzzer</property>
  <property name="variant">buzzer-ativo</property>
  <property name="size">32 x 15 mm</property>
  <property name="voltage">3.3-5V</property>
  <property name="current">42mA max</property>
  <property name="type">active buzzer</property>
 </properties>
 <views>
  <breadboardView>
   <layers image="breadboard/buzzer_ativo_breadboard.svg">
    <layer layerId="breadboard"/>
   </layers>
  </breadboardView>
  <schematicView>
   <layers image="schematic/buzzer_ativo_schematic.svg">
    <layer layerId="schematic"/>
   </layers>
  </schematicView>
  <pcbView>
   <layers image="pcb/buzzer_ativo_pcb.svg">
    <layer layerId="copper1"/>
    <layer layerId="copper0"/>
    <layer layerId="silkscreen"/>
   </layers>
  </pcbView>
  <iconView>
   <layers image="icon/buzzer_ativo_icon.svg">
    <layer layerId="icon"/>
   </layers>
  </iconView>
 </views>
 <connectors>
  <connector type="male" name="GND" id="connector0">
   <description>GND</description>
   <views>
    <breadboardView><p svgId="connector0pin" layer="breadboard"/></breadboardView>
    <schematicView><p svgId="connector0pin" layer="schematic"/></schematicView>
    <pcbView><p svgId="connector0pin" layer="copper0"/><p svgId="connector0pin" layer="copper1"/></pcbView>
   </views>
  </connector>
  <connector type="male" name="SINAL" id="connector1">
   <description>SINAL</description>
   <views>
    <breadboardView><p svgId="connector1pin" layer="breadboard"/></breadboardView>
    <schematicView><p svgId="connector1pin" layer="schematic"/></schematicView>
    <pcbView><p svgId="connector1pin" layer="copper0"/><p svgId="connector1pin" layer="copper1"/></pcbView>
   </views>
  </connector>
 </connectors>
 <buses/>
</module>
