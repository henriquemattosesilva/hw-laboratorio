  <property name="family">nodemcu esp8266</property>
  <property name="variant">nodemcu-lolin-v3</property>
  <property name="size">59 x 31 mm</property>
  <property name="row spacing">1.1in</property>
  <property name="processor">ESP8266 ESP-12E</property>
  <property name="logic level">3.3V</property>
  <property name="voltage">4.5-9V (VIN)</property>
 </properties>
