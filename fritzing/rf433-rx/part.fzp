<?xml version="1.0" encoding="UTF-8"?>
<module moduleId="rf433-rx-mx05v-hwlab" fritzingVersion="1.0.4">
 <version>1</version>
 <date>2026-09-06</date>
 <author>hw-laboratorio</author>
 <title>RF 433 MHz RX (MX-05V)</title>
 <label>M</label>
 <description>Modulo receptor de radiofrequencia 433 MHz por modulacao de amplitude, modelo MX-05V (tambem MX-RM-5V). Placa de 30 x 14 mm, 5 V, cerca de 4 mA, sensibilidade de -105 dB. Tem quatro pinos, dois deles DATA ligados internamente: usar qualquer um. Pinagem VCC DATA DATA GND da esquerda para a direita VISTA DE CIMA; a serigrafia fica no verso, onde se le o inverso. Os receptores baratos sao superregenerativos e pegam ruido o tempo todo — o superheterodino custa pouco mais e e outro mundo. Precisa de antena: um fio reto de 17,3 cm. Bibliotecas RadioHead RH_ASK ou RCSwitch.</description>
 <url>https://github.com/henriquemattosesilva/hw-laboratorio</url>
 <tags>
  <tag>rf</tag>
  <tag>433mhz</tag>
  <tag>receiver</tag>
  <tag>ask</tag>
  <tag>mx-05v</tag>
  <tag>mx-rm-5v</tag>
 </tags>
 <properties>
  <property name="family">rf module 433mhz</property>
  <property name="variant">receiver MX-05V</property>
  <property name="part number">MX-05V</property>
  <property name="frequency">433 MHz</property>
  <property name="voltage">5V</property>
  <property name="sensitivity">-105 dB</property>
 </properties>
 <views>
  <breadboardView>
   <layers image="breadboard/rf433_rx_breadboard.svg">
    <layer layerId="breadboard"/>
   </layers>
  </breadboardView>
  <schematicView>
   <layers image="schematic/rf433_rx_schematic.svg">
    <layer layerId="schematic"/>
   </layers>
  </schematicView>
  <pcbView>
   <layers image="pcb/rf433_rx_pcb.svg">
    <layer layerId="copper1"/>
    <layer layerId="copper0"/>
    <layer layerId="silkscreen"/>
   </layers>
  </pcbView>
  <iconView>
   <layers image="icon/rf433_rx_icon.svg">
    <layer layerId="icon"/>
   </layers>
  </iconView>
 </views>
 <connectors>
  <connector type="male" name="VCC" id="connector0">
   <description>Alimentacao, 5 V</description>
   <views>
    <breadboardView><p svgId="connector0pin" layer="breadboard"/></breadboardView>
    <schematicView><p svgId="connector0pin" layer="schematic"/></schematicView>
    <pcbView><p svgId="connector0pin" layer="copper0"/><p svgId="connector0pin" layer="copper1"/></pcbView>
   </views>
  </connector>
  <connector type="male" name="DATA" id="connector1">
   <description>Saida de dados; ligada internamente ao outro DATA</description>
   <views>
    <breadboardView><p svgId="connector1pin" layer="breadboard"/></breadboardView>
    <schematicView><p svgId="connector1pin" layer="schematic"/></schematicView>
    <pcbView><p svgId="connector1pin" layer="copper0"/><p svgId="connector1pin" layer="copper1"/></pcbView>
   </views>
  </connector>
  <connector type="male" name="DATA2" id="connector2">
   <description>Mesma saida de dados; os dois pinos sao o mesmo ponto na placa</description>
   <views>
    <breadboardView><p svgId="connector2pin" layer="breadboard"/></breadboardView>
    <schematicView><p svgId="connector2pin" layer="schematic"/></schematicView>
    <pcbView><p svgId="connector2pin" layer="copper0"/><p svgId="connector2pin" layer="copper1"/></pcbView>
   </views>
  </connector>
  <connector type="male" name="GND" id="connector3">
   <description>Terra</description>
   <views>
    <breadboardView><p svgId="connector3pin" layer="breadboard"/></breadboardView>
    <schematicView><p svgId="connector3pin" layer="schematic"/></schematicView>
    <pcbView><p svgId="connector3pin" layer="copper0"/><p svgId="connector3pin" layer="copper1"/></pcbView>
   </views>
  </connector>
  <connector type="male" name="ANT" id="connector4">
   <description>Furo da antena; um fio reto de 17,3 cm e um quarto de onda em 433,92 MHz</description>
   <views>
    <breadboardView><p svgId="connector4pin" layer="breadboard"/></breadboardView>
    <schematicView><p svgId="connector4pin" layer="schematic"/></schematicView>
    <pcbView><p svgId="connector4pin" layer="copper0"/><p svgId="connector4pin" layer="copper1"/></pcbView>
   </views>
  </connector>
 </connectors>
 <buses>
  <bus id="dados">
   <nodeMember connectorId="connector1"/>
   <nodeMember connectorId="connector2"/>
  </bus>
 </buses>
</module>
